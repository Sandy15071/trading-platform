# Zerodha Kite Connect Credentials
# Obtain API Key and Secret from https://developers.kite.trade
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
# Daily access token generated upon login (or auto-updated via web UI)
KITE_ACCESS_TOKEN=

# Telegram Notification Settings (Optional)
# Create a bot via @BotFather and get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Operating Mode: Set to true to run mock/simulated option chain data (useful on weekends/after-hours)
MOCK_MODE=true

# Server Settings
HOST=127.0.0.1
PORT=8000
POLL_INTERVAL=1
